rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth & Identity Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Static Schema Validation
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'fullName', 'passwordHash', 'passwordSalt'])
        && data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 128
        && data.fullName is string && data.fullName.size() <= 128
        && data.passwordHash is string && data.passwordHash.size() <= 256
        && data.passwordSalt is string && data.passwordSalt.size() <= 128;
    }

    // Users collection rules
    match /users/{userId} {
      allow get: if isOwner(userId) || !isSignedIn(); // allow server-side lookup or owner
      allow create: if (isOwner(userId) || !isSignedIn()) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) || !isSignedIn()) && isValidUser(request.resource.data);
      allow delete: if false;
    }
  }
}
